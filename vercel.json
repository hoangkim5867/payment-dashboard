{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node deployment/build-site.cjs",
  "outputDirectory": "build/site",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/cash-shared-test-google-probe",
      "destination": "/api/cash-shared-test?operation=google-probe"
    },
    {
      "source": "/api/cash-shared-test-history-audit",
      "destination": "/api/cash-shared-test?operation=history-audit"
    },
    {
      "source": "/api/cash-shared-test-idempotency",
      "destination": "/api/cash-shared-test?operation=idempotency"
    },
    {
      "source": "/api/cash-shared-test-real-compare",
      "destination": "/api/cash-shared-test?operation=real-compare"
    }
  ]
}
