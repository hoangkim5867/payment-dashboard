// INSERT these match blocks and functions INSIDE the existing
// match /databases/{database}/documents { ... } in CURRENT LIVE Rules.
// Do NOT replace any existing Payment Rules. Requires existing approvedUser() and adminUser().
// This file is a fragment, not a complete ruleset.
function noelEnabled2026(){
  return approvedUser();
}
function noelTreeData2026(d){
  return d.keys().hasOnly(['name','style','color','updatedAt','decorations'])
    && d.get('decorations',[]) is list && d.get('decorations',[]).size() <= 60
    && d.name is string && d.name.size() > 0 && d.name.size() <= 32
    && d.style in ['pastel','chalet'] && d.color in ['pink','green','snow','cream','berry','lavender','mint','peach','pearl','navy','gold','matcha']
    && d.updatedAt == request.time;
}
match /noelTreeConfig2026/settings {
  allow get: if approvedUser();
  allow create, update: if adminUser()
    && request.resource.data.keys().hasOnly(['enabled','updatedAt'])
    && request.resource.data.enabled is bool && request.resource.data.updatedAt == request.time;
}
match /noelTrees2026/{uid} {
  allow get, list: if noelEnabled2026();
  allow create, update: if noelEnabled2026() && request.auth.uid == uid && noelTreeData2026(request.resource.data);
  match /gifts/{giftId} {
    allow get, list: if noelEnabled2026();
    allow create: if noelEnabled2026() && exists(/databases/$(database)/documents/noelTrees2026/$(uid))
      && request.resource.data.keys().hasOnly(['kind','senderUid','sender','x','y','createdAt'])
      && request.resource.data.senderUid == request.auth.uid
      && request.resource.data.sender is string && request.resource.data.sender.size() <= 32
      && request.resource.data.kind in ['bear','snow','gift','bow','star','bell','candy','heart','deer','cookie','sock','moon','flake','penguin','ball','candle','ball_gold','ball_emerald','ball_blue','ball_lilac','ball_rose','ball_pearl','ball_rainbow','bow_red','bow_gold','bow_mint','bow_lilac','gift_pink','gift_blue','gift_vintage','gift_gold','star_pink','star_ice','star_glow','heart_lilac','heart_gold','gem_aqua','gem_pink','gem_violet','pearl','crown','angel','spark','candycane','cane_mint','holly','santa','sleigh','polar','ice','cloud','snow_white','rabbit','cat_santa','capybara','duck_santa','frog','mushroom','boba','croissant','pizza','earth','camera','laptop','fish','strawberry','cupcake','macaron','lollipop','cocoa','ginger','pinecone','mitten','scarf','cabin','lantern','woodstar','snowglobe','clover','music','ribbon_blue','cash_green','cash_pink','cash_blue','money_bag','money_bag_red','gold_bar','gold_coin','cash_wings','red_envelope','pink_envelope','treasure','lucky_cat','diamond_ring','gold_ring','money_tree','wallet','credit_card','chart_up','lottery','lips_red','lips_pink','lips_wine','lipstick_red','lipstick_pink','perfume_pink','perfume_blue','handbag_pink','handbag_black','heel_pink','heel_red','nail_polish','mirror','compact','sunglasses','shopping','ribbon_long','princess_ice','princess_rose','princess_gold','princess_lilac','princess_mint','princess_ruby','mermaid_red','mermaid_purple','fairy_pink','fairy_blue','castle_pink','castle_ice','wand_pink','wand_gold','glass_slipper','dress_pink','dress_blue','dress_gold','mouse_bow','mouse_red','alien_blue','alien_pink','unicorn','carriage','butterfly_blue','butterfly_pink','butterfly_violet','butterfly_mint','butterfly_gold','rose_red','rose_pink','flower_blue','flower_white','flower_lilac','sunflower','tulip','bouquet','four_leaf','bee','ladybug','kitty_white','kitty_black','kitty_orange','kitty_gray','bunny_pink','bunny_white','puppy','panda','hamster','fox','koala','otter','chick','dinosaur','whale','octopus','paw','coffee','matcha_latte','wine','champagne','beer','cocktail','cake','donut','icecream','chocolate','cherry','peach_fruit','grapes','watermelon','sushi','ramen','hotpot','dumpling','burger','fries','fried_chicken','avocado','kiss_face','heart_eyes','laugh','cool_face','cry','party','poop','ghost','rocket','ufo','gamepad','headphones','airplane','car','beach','sun','rainbow_arc','love_letter','ribbon_heart','fire','trophy','medal','party_popper','balloon']
      && request.resource.data.x is number && request.resource.data.x >= 0 && request.resource.data.x <= 100
      && request.resource.data.y is number && request.resource.data.y >= 0 && request.resource.data.y <= 82
      && request.resource.data.createdAt == request.time
      && getAfter(/databases/$(database)/documents/noelTrees2026/$(uid)/wishes/$(giftId)).data.senderUid == request.auth.uid;
    // Tree owner may rearrange or hide a received gift; its wish and sender stay immutable.
    allow update: if noelEnabled2026() && request.auth.uid == uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['x','y','hidden','updatedAt'])
      && request.resource.data.x is number && request.resource.data.x >= 0 && request.resource.data.x <= 100
      && request.resource.data.y is number && request.resource.data.y >= 0 && request.resource.data.y <= 82
      && request.resource.data.get('hidden',false) is bool
      && request.resource.data.updatedAt == request.time;
  }
  match /wishes/{giftId} {
    allow get, list: if noelEnabled2026() && request.auth.uid == uid
      && request.time >= timestamp.date(2026,12,22) + duration.value(17,'h');
    allow create: if noelEnabled2026() && request.resource.data.keys().hasOnly(['senderUid','message','createdAt'])
      && request.resource.data.senderUid == request.auth.uid
      && request.resource.data.message is string && request.resource.data.message.size() <= 160
      && request.resource.data.createdAt == request.time
      && getAfter(/databases/$(database)/documents/noelTrees2026/$(uid)/gifts/$(giftId)).data.senderUid == request.auth.uid;
  }
}
